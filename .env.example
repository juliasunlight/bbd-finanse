# Konfiguracja aplikacji webowej z Firebase (Ustawienia projektu → Twoje aplikacje → Web).
# To są publiczne identyfikatory, nie sekrety; dostęp do danych chronią reguły firestore.rules.
# Zmienne nie są obowiązkowe: konfiguracja jest już wpisana w lib/firebase.ts (obecnie kod ich nie czyta).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
